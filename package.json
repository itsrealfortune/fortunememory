{
	"name": "fortunememory",
	"version": "1.0.3",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsrealfortune/fortunememory"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2"
	},
	"optionalDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"mysql2": "^3.24.4",
		"roxify": "^1.16.17"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"fortune-migrate": "./dist/migrate.js"
	},
	"description": "Durable local memory for AI agents as native in-process tools (OpenCode plugin): hybrid search, conflicts, source-attributed context. Zero network, native sqlite.",
	"engines": {
		"node": ">=22.5"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"homepage": "https://github.com/itsrealfortune/fortunememory#readme",
	"keywords": ["memory", "agent", "sqlite", "vector-search", "opencode"],
	"license": "MIT",
	"scripts": {
		"prepack": "npm run build",
		"build": "tsc --project tsconfig.json",
		"typecheck": "tsc --noEmit --project tsconfig.json",
		"test": "npm run build && node ./dist/test.js",
		"bench": "npm run build && node scripts/bench.mjs",
		"bench:vs-openself": "npm run build && node scripts/bench-vs-openself.mjs",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh"
	},
	"type": "module",
	"types": "./dist/index.d.ts"
}
